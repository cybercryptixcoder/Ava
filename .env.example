# Ava configuration. Copy to .env and fill in what you have.
# Real environment variables take precedence over this file, so you can also export these in your shell.
# Missing optional keys only disable their feature; `npm run config:check` shows what is on and off.

# --- Core ---
# Which data profile to run: real (your data) or test (fixture data, time simulation allowed).
AVA_PROFILE=real
# Directory for the database, audio and exports. Each profile gets its own subfolder.
AVA_DATA_DIR=./data
# HTTP port the server listens on.
PORT=4317
# Interface to bind. Use 127.0.0.1 behind a tunnel.
HOST=127.0.0.1
# The public https URL you reach Ava at (your tunnel hostname). Used for OAuth redirects, push and calendar webhooks. Get it: Your tunnel, e.g. https://ava.example.com.
PUBLIC_URL=http://localhost:4317
# scrypt hash of your login password. Get it: npm run hash-password. Required in production.
AVA_PASSWORD_HASH=
# Plain login password (alternative to AVA_PASSWORD_HASH; hashed in memory at startup). Prefer the hash.
AVA_PASSWORD=
# Random secret (32+ chars) used to sign session cookies. Get it: openssl rand -hex 32. Required in production.
AVA_SESSION_SECRET=
# 32-byte key (64 hex chars) that encrypts sensitive data at rest. Losing it makes encrypted data unreadable. Get it: openssl rand -hex 32. Required in production.
AVA_ENCRYPTION_KEY=
# Your first name, used in prompts.
AVA_OWNER_NAME=Shreyas

# --- Models ---
# Anthropic API key. Powers planning, conversation, extraction, executors and live mode. Get it: https://platform.claude.com/settings/keys.
ANTHROPIC_API_KEY=
# Model for planning sessions and the weekly review.
MODEL_PLANNER=claude-opus-5-5
# Model for async conversation and the morning brief.
MODEL_CONVERSATION=claude-sonnet-5-5
# Model for live voice mode (claude-sonnet-5-5 or claude-haiku-4-5-20251001).
MODEL_LIVE=claude-sonnet-5-5
# The faster live-mode option offered in settings.
MODEL_LIVE_FAST=claude-haiku-4-5-20251001
# Model for extraction, session labeling, candidate ranking and the affirmation check.
MODEL_FAST=claude-haiku-4-5-20251001
# Model for executor sessions that produce artifacts.
MODEL_EXECUTOR=claude-sonnet-5-5
# Opt in to server-side refusal fallbacks on Opus/Sonnet requests (true/false).
ANTHROPIC_REFUSAL_FALLBACK=true
# Max model calls per day that Ava starts on her own (wakes, planning, executors).
BUDGET_SYSTEM_CALLS_PER_DAY=120
# Max model calls per day you start (conversation, live turns, imports).
BUDGET_INTERACTIVE_CALLS_PER_DAY=600
# Hard daily spend ceiling across all model calls, in US dollars.
BUDGET_USD_PER_DAY=8

# --- Voice ---
# ElevenLabs key: expressive and low-latency text-to-speech with the same voice. Get it: https://elevenlabs.io/app/settings/api-keys.
ELEVENLABS_API_KEY=
# Default ElevenLabs voice id (change it in the voice audition). Get it: ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=
# Cartesia key: Sonic text-to-speech with native word timestamps. Get it: https://play.cartesia.ai/keys.
CARTESIA_API_KEY=
# Default Cartesia voice id. Get it: Cartesia playground.
CARTESIA_VOICE_ID=
# Deepgram key: Flux streaming speech-to-text with semantic end-of-turn, and audio file transcription. Get it: https://console.deepgram.com.
DEEPGRAM_API_KEY=
# AssemblyAI key: alternative streaming speech-to-text with semantic turn detection. Get it: https://www.assemblyai.com/app/api-keys.
ASSEMBLYAI_API_KEY=

# --- Push ---
# Web push public key. Generate both with `npm run vapid`. Get it: npm run vapid.
VAPID_PUBLIC_KEY=
# Web push private key. Get it: npm run vapid.
VAPID_PRIVATE_KEY=
# Contact for push services, mailto: or https: URL.
VAPID_SUBJECT=mailto:ava@localhost

# --- Google ---
# OAuth client id for Google Calendar and Gmail (Web application type). Get it: Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
# OAuth client secret for the same client. Get it: Google Cloud Console.
GOOGLE_CLIENT_SECRET=
# Allow sending drafts via Gmail after explicit confirmation each time (adds the gmail.send scope).
GMAIL_SEND_ENABLED=false

# --- Sources ---
# Wispr Flow's official remote MCP endpoint. You sign in through OAuth from Settings.
WISPR_MCP_URL=https://api.wisprflow.ai/connect/mcp

# --- Monitoring ---
# Optional external heartbeat URL (e.g. healthchecks.io) pinged after each successful wake, so you hear about it even if the server is down. Get it: https://healthchecks.io.
DEADMAN_PING_URL=
# Shared token the activity collector uses to post sessions. Generate any long random string. Get it: openssl rand -hex 24.
COLLECTOR_TOKEN=

# --- Memory ---
# Optional hosted embeddings endpoint (OpenAI-compatible /v1/embeddings). Left unset, memory embeds locally on this machine so nothing leaves the server. Get it: e.g. https://api.openai.com/v1/embeddings.
EMBEDDINGS_URL=
# Key for the hosted embeddings endpoint, if one is configured.
EMBEDDINGS_API_KEY=
# Model name for the hosted embeddings endpoint.
EMBEDDINGS_MODEL=text-embedding-3-small
